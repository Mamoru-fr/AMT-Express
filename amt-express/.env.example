# AMT Express — template des variables d'environnement
# Copier ce fichier en `.env` (ou `.env.local`), puis remplir les valeurs.
# Ne jamais committer de vraies valeurs : `.env` est ignoré par git.

# --- Base de données (PostgreSQL / Neon) ---
# Chaîne de connexion complète. Utilisée par Drizzle (drizzle.config.ts,
# lib/db/drizzle.ts) et les scripts db:push / db:migrate / db:backup / db:import-csv.
# Format : postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@host:port/database

# --- Authentification (Better Auth) ---
# Secret de signature des sessions (≥ 32 caractères). Lu nativement par Better Auth
# et injecté en CI par les workflows GitHub Actions.
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Application ---
# URL publique de l'application (metadataBase, app/layout.tsx).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mails (optionnel — provider non branché, cf. lib/utils/email.ts) ---
# À renseigner au branchement d'un provider (ex. Resend) :
# RESEND_API_KEY=
# SMTP_FROM=

# Note : NODE_ENV est géré automatiquement par Next.js et la CI — ne pas définir.
