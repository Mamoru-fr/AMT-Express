{
  "name": "amt-express",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:migrate": "drizzle-kit generate && drizzle-kit migrate",
    "db:generate": "drizzle-kit generate && drizzle-kit push",
    "db:import-csv": "pnpm db:backup && tsx lib/db/import-csv.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run test/actionResponse.test.ts test/isValidUserRole.test.ts test/translations.test.ts test/validations.test.ts test/import-csv.test.ts test/components/Button.test.tsx",
    "test:auth": "vitest run test/actions/AuthActions.test.ts",
    "test:rides": "vitest run test/actions/RidesManagementActions.test.ts",
    "test:integration": "vitest run test/actions/AuthActions.test.ts test/actions/RidesManagementActions.test.ts",
    "ci": "pnpm build && pnpm test"
  },
  "dependencies": {
    "i18next": "^25.7.4",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.5.1",
    "recharts": "^3.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.16",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-auth": "^1.4.10",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}